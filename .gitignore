# --- Secrets: never commit these ---
.env
*.p8
*.pem
*.key
config.toml
profiles.yml
# dbt/profiles.yml uses env vars only, so it is safe to commit
!dbt/profiles.yml

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/

# --- Local generator output ---
data/

# --- Raw agent eval runs (summaries go in agent/evals/results/*.md) ---
agent/evals/results/*.json

# --- Snowflake CLI build output ---
snowpark/*.zip
snowpark/src/*.zip
snowpark/output/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
dbt/.user.yml
